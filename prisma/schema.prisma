generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String
  siren     String
  address   String
  city      String
  zip       String
  country   String   @default("FR")
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  twoFactorEnabled Boolean  @default(false)

  /// Legacy demo role (BUYER/VENDOR/OPENING_*). Prefer Membership + TenderAssignment.
  role      String  @default("member")
  title     String  @default("")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])

  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  memberships        Membership[]
  invitationsSent    OrgInvitation[]     @relation("InvitationInviter")
  tenderAssignments  TenderAssignment[]
  mfaStepUps         MfaStepUp[]
  tendersCreated     Tender[]            @relation("TenderCreator")
  tendersKeyA        Tender[]            @relation("TenderKeyA")
  tendersKeyB        Tender[]            @relation("TenderKeyB")
  tenderVersions     TenderVersion[]
  requisitions       Requisition[]
  approvalSteps      ApprovalStep[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  invoices           Invoice[]
  payments           Payment[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  tenderOpenings     TenderOpening[]
  mismatchApprovals  Invoice[]           @relation("MismatchApprover")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
}

/// Buyer or supplier organization (additive; Company/Vendor kept for RFQ compatibility).
model Organization {
  id        String   @id @default(cuid())
  name      String
  type      String // buyer | supplier
  vendorId  String?  @unique
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  invitations OrgInvitation[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgRole   String // owner | admin | member
  createdAt DateTime @default(now())
  @@unique([userId, orgId])
}

model OrgInvitation {
  id          String    @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  token       String    @unique
  orgRole     String    @default("member")
  invitedById String
  invitedBy   User      @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/// Per-AO (tender) role assignment on the buyer/supplier side.
model TenderAssignment {
  id        String   @id @default(cuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aoRole    String // owner | editor | keyholder | evaluator | viewer | bidder
  keySlot   String? // A | B for keyholders
  createdAt DateTime @default(now())
  @@unique([tenderId, userId, aoRole])
}

model MfaStepUp {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  purpose    String // key_open | sensitive
  verifiedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  @@index([userId, purpose])
}

model ApprovalThreshold {
  id        String  @id @default(cuid())
  minAmount Float
  maxAmount Float?
  levels    String
  label     String
}

model ChartOfAccount {
  id        String    @id @default(cuid())
  code      String    @unique
  label     String
  type      String
  invoices  Invoice[]
}

model Vendor {
  id        String  @id @default(cuid())
  name      String
  legalName String
  siren     String?
  iban      String?
  email     String?
  city      String?
  category  String?
  users         User[]
  invites       TenderInvite[]
  bids          Bid[]
  pos           PurchaseOrder[]
  invoices      Invoice[]
  organization  Organization?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  details    String
  orgId      String?
  aoId       String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Tender {
  id            String   @id @default(cuid())
  number        String   @unique
  title         String
  briefing      String
  status        String
  deadline      DateTime
  currency      String   @default("EUR")
  createdById   String
  createdBy     User     @relation("TenderCreator", fields: [createdById], references: [id])
  awardedBidId  String?
  keyAUserId    String
  keyAUser      User     @relation("TenderKeyA", fields: [keyAUserId], references: [id])
  keyBUserId    String
  keyBUser      User     @relation("TenderKeyB", fields: [keyBUserId], references: [id])
  keyAHash      String?
  keyBHash      String?
  keyAUnlocked  Boolean  @default(false)
  keyBUnlocked  Boolean  @default(false)
  publishedAt   DateTime?
  openedAt      DateTime?
  createdAt     DateTime @default(now())
  invites       TenderInvite[]
  versions      TenderVersion[]
  bids          Bid[]
  openings      TenderOpening[]
  requisitions  Requisition[]
  assignments   TenderAssignment[]
}

model TenderInvite {
  id         String    @id @default(cuid())
  tenderId   String
  tender     Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  notifiedAt DateTime?
  @@unique([tenderId, vendorId])
}

model TenderVersion {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  summary     String
  briefing    String
  createdAt   DateTime @default(now())
}

model Bid {
  id          String   @id @default(cuid())
  tenderId    String
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  payload     String
  submittedAt DateTime @default(now())
  @@unique([tenderId, vendorId])
}

model TenderOpening {
  id        String   @id @default(cuid())
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  officerId String
  officer   User     @relation(fields: [officerId], references: [id])
  lock      String
  success   Boolean
  createdAt DateTime @default(now())
}

model Requisition {
  id          String   @id @default(cuid())
  number      String   @unique
  title       String
  description String
  type        String
  amountHT    Float
  currency    String   @default("EUR")
  costCenter  String
  neededBy    DateTime
  status      String
  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id])
  createdAt   DateTime @default(now())
  submittedAt DateTime?
  tenderId    String?
  tender      Tender?  @relation(fields: [tenderId], references: [id])
  steps       ApprovalStep[]
  purchaseOrders PurchaseOrder[]
}

model ApprovalStep {
  id            String       @id @default(cuid())
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level         String
  approverId    String
  approver      User         @relation(fields: [approverId], references: [id])
  status        String
  decidedAt     DateTime?
  comment       String?
  stepOrder     Int
}

model PurchaseOrder {
  id            String       @id @default(cuid())
  number        String       @unique
  requisitionId String
  requisition   Requisition  @relation(fields: [requisitionId], references: [id])
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  terms         String
  status        String
  issuedAt      DateTime     @default(now())
  issuedById    String
  issuedBy      User         @relation(fields: [issuedById], references: [id])
  currency      String       @default("EUR")
  lines         POLine[]
  receipts      GoodsReceipt[]
  invoices      Invoice[]
}

model POLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  description String
  qty         Float
  unit        String
  unitPrice   Float
  grLines     GRLine[]
}

model GoodsReceipt {
  id           String        @id @default(cuid())
  number       String        @unique
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  type         String
  receivedById String
  receivedBy   User          @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime      @default(now())
  notes        String?
  status       String        @default("confirmed")
  lines        GRLine[]
  accruals     Accrual[]
}

model GRLine {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLineId    String
  poLine      POLine       @relation(fields: [poLineId], references: [id])
  description String
  qtyOrdered  Float
  qtyReceived Float
  unitPrice   Float
}

model Accrual {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id])
  accountCode String
  amount      Float
  status      String
  createdAt   DateTime     @default(now())
}

model Invoice {
  id              String           @id @default(cuid())
  number          String
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  poId            String?
  po              PurchaseOrder?   @relation(fields: [poId], references: [id])
  invoiceDate     DateTime
  dueDate         DateTime
  currency        String           @default("EUR")
  amountHT        Float
  vatAmount       Float
  vatRate         Float
  whtAmount       Float            @default(0)
  whtRate         Float            @default(0)
  otherTaxes      Float            @default(0)
  amountTTC       Float
  glAccountId     String?
  glAccount       ChartOfAccount?  @relation(fields: [glAccountId], references: [id])
  status          String
  filename        String?
  extractedText   String?
  matchResult     String?
  createdAt       DateTime         @default(now())
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  mismatchApproverId String?
  mismatchApprover   User?         @relation("MismatchApprover", fields: [mismatchApproverId], references: [id])
  lines           InvoiceLine[]
  steps           ApprovalStep[]
  payments        PaymentItem[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Float
  unitPrice   Float
  amount      Float
}

model Payment {
  id           String        @id @default(cuid())
  runNumber    String        @unique
  method       String        @default("virement")
  paymentDate  DateTime
  status       String
  executedById String
  executedBy   User          @relation(fields: [executedById], references: [id])
  createdAt    DateTime      @default(now())
  items        PaymentItem[]
}

model PaymentItem {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Float
}
